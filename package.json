{
  "name": "lumio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typegen": "next typegen",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:bundle": "node scripts/check-client-bundle.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "db:types": "node scripts/sandbox-stack/gen-types.mjs",
    "db:types:check": "node scripts/sandbox-stack/gen-types.mjs --check",
    "sandbox": "scripts/sandbox-stack/stack.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "katex": "^0.19.1",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.11 <23"
  }
}
