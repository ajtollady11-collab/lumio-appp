# Lumio environment variables — names only. Never commit real values.
# Copy to .env.local for local development (.env* files are git-ignored).
#
# Server-only values are validated by src/lib/env/schema.ts; the build fails if
# one is invalid. Anything prefixed NEXT_PUBLIC_ is sent to the browser, so a
# secret must NEVER use that prefix.

# --- M1a -------------------------------------------------------------------
# local | preview | production. Optional: on Vercel it is derived from VERCEL_ENV.
APP_ENV=local
# Public base URL used for metadata (e.g. https://lumio.example). Optional.
NEXT_PUBLIC_SITE_URL=

# --- Added in later milestones (not read yet) ------------------------------
# M1c Supabase:  NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY, SUPABASE_SECRET_KEY
# M3  Anthropic: ANTHROPIC_API_KEY
# M6  Stripe:    STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET
