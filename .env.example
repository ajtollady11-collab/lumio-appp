# Lumio environment variables — names only. Never commit real values.
# Copy to .env.local for local development (.env* files are git-ignored).
#
# Server-only values are validated by src/lib/env/schema.ts; the build fails if
# one is invalid. Anything prefixed NEXT_PUBLIC_ is sent to the browser, so a
# secret must NEVER use that prefix.

# local | preview | production. Optional: on Vercel it is derived from VERCEL_ENV.
APP_ENV=local
# Public base URL, used for metadata and for links in auth emails (e.g. https://lumio.example).
NEXT_PUBLIC_SITE_URL=

# --- Supabase (server-only; the browser never talks to Supabase) --------------
# Project URL and the *publishable* (anon) key. Set both or neither.
# Lumio never uses a service-role / secret key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# --- AI tutor (server-only) ------------------------------------------------------
# Without a key the tutor shows a clear "not configured" message.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-5-5.
TUTOR_MODEL=
# Optional: anthropic (default) | test. "test" returns fixed replies labelled
# "not generated by AI" for automated tests; it is refused when APP_ENV=production.
TUTOR_PROVIDER=
